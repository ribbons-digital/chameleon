{
  "name": "chameleon",
  "private": true,
  "version": "1.0.0",
  "description": "A WebMCP canvas composed in conversation.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4711",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0 --port 4711",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.5.0",
    "@astryxdesign/theme-butter": "^0.5.0",
    "@astryxdesign/theme-chocolate": "^0.5.0",
    "@astryxdesign/theme-gothic": "^0.5.0",
    "@astryxdesign/theme-matcha": "^0.5.0",
    "@astryxdesign/theme-neutral": "^0.5.0",
    "@astryxdesign/theme-stone": "^0.5.0",
    "@astryxdesign/theme-y2k": "^0.5.0",
    "@stylexjs/stylex": "^0.19.0",
    "immer": "^11.1.18",
    "nanoid": "^6.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.2.4",
    "recharts": "^3.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.5.0",
    "@mcp-b/webmcp-types": "^5.0.1",
